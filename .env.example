# Copy to .env before running `docker compose up`. .env is gitignored.
POSTGRES_DB=travelops
POSTGRES_USER=travelops
POSTGRES_PASSWORD=change-me-local

# HMAC key for signing JWTs, at least 32 bytes. Replace it with your own: openssl rand -base64 48
JWT_SECRET=local-dev-only-secret-replace-me-0123456789
